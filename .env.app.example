# MYSQL_HOST/PORT/USER/PASSWORD are read from .env; the old MYSQL_DATABASE is untouched.
APP_DATABASE=electronics_ecommerce
APP_HOST=127.0.0.1
APP_PORT=8008
APP_SESSION_HOURS=12
APP_CONTEXT_SECONDS=1800
APP_CLIP_MODEL=ViT-B-32
APP_CLIP_PRETRAINED=laion2b_s34b_b79k
APP_AI_DEVICE=cpu
APP_IMAGE_MIN_SIMILARITY=0.25
APP_DETECTOR_PROVIDER=owlv2
APP_DETECTOR_DEVICE=cpu
APP_DETECTOR_LABEL_POLICY=provided_catalogue
# Used only when APP_DETECTOR_PROVIDER=owlvit (legacy detector).
APP_DETECTOR_MODEL=google/owlvit-base-patch32
# Active providers. Gemini key is read again on each request.
APP_TRANSCRIBE_PROVIDER=gemini
APP_INTENT_PROVIDER=gemini
APP_GEMINI_API_KEY=
APP_GEMINI_TRANSCRIBE_MODEL=gemini-3.1-flash-lite
APP_GEMINI_INTENT_MODEL=gemini-3.1-flash-lite
# Legacy OpenAI settings are used only when APP_TRANSCRIBE_PROVIDER=openai.
APP_OPENAI_API_KEY=
APP_TRANSCRIBE_MODEL=gpt-transcribe
APP_TRANSCRIBE_BASE=https://api.openai.com/v1
